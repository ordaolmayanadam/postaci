<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A made-up mailbox that answers EWS requests in memory, for screenshots and trying the interface without a server.
    Only Debug builds of the app reference it (started with ‒‒demo); the Store package does not contain it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ExchangeMail.Demo</RootNamespace>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ExchangeMail.Core\ExchangeMail.Core.csproj" />
  </ItemGroup>
</Project>
