<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ExchangeMail.App.Views.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ExchangeMail.App.Controls"
    xmlns:h="using:ExchangeMail.App.Helpers"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:ExchangeMail.ViewModels"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="316" MinWidth="264" MaxWidth="480" />
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition x:Name="DetailColumn" Width="400" MinWidth="280" MaxWidth="900" />
        </Grid.ColumnDefinitions>

        <!--  Month picker  -->
        <!--  The top padding puts New event level with the agenda's title next to it.  -->
        <StackPanel Padding="8,12,8,8" Spacing="12">
            <!--  Like New mail: sized to its content, at the top left of the sidebar.  -->
            <Button
                Margin="4,0"
                Click="OnNewEvent"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="{h:L Key=Calendar_NewEvent}" />
                </StackPanel>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="N" Modifiers="Control" />
                </Button.KeyboardAccelerators>
            </Button>
            <!--
                The month fills the column (the sidebar's minimum width keeps seven day cells). Lightweight styling:
                weekday names drop the template's 12 px side padding, which made "Pzt"/"Mon" wrap in narrow columns,
                and day cells may be smaller than the default 40 px.
            -->
            <CalendarView
                x:Name="MonthView"
                HorizontalAlignment="Stretch"
                IsTodayHighlighted="True"
                SelectedDatesChanged="OnSelectedDatesChanged"
                SelectionMode="Single">
                <CalendarView.Resources>
                    <Thickness x:Key="CalendarViewWeekDayPadding">0,12</Thickness>
                </CalendarView.Resources>
                <CalendarView.CalendarViewDayItemStyle>
                    <Style TargetType="CalendarViewDayItem">
                        <Setter Property="MinWidth" Value="32" />
                        <Setter Property="MinHeight" Value="32" />
                    </Style>
                </CalendarView.CalendarViewDayItemStyle>
            </CalendarView>
        </StackPanel>

        <!--  Agenda  -->
        <Grid
            Grid.Column="1"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,1,0,0"
            CornerRadius="8,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Padding="12,12,12,4" Spacing="8">
                <Grid>
                    <TextBlock
                        Text="{x:Bind ViewModel.RangeText, Mode=OneWay}"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <ProgressRing
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Right"
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Command="{x:Bind ViewModel.PreviousCommand}" ToolTipService.ToolTip="{h:L Key=Calendar_Previous}">
                        <FontIcon Glyph="&#xE76B;" FontSize="12" />
                    </Button>
                    <Button Content="{h:L Key=Calendar_Today}" Command="{x:Bind ViewModel.TodayCommand}" />
                    <Button Command="{x:Bind ViewModel.NextCommand}" ToolTipService.ToolTip="{h:L Key=Calendar_Next}">
                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                    </Button>
                    <ComboBox MinWidth="100" SelectedIndex="{x:Bind ViewModel.RangeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{h:L Key=Calendar_Day}" />
                        <ComboBoxItem Content="{h:L Key=Calendar_Week}" />
                        <ComboBoxItem Content="{h:L Key=Calendar_Month}" />
                    </ComboBox>
                    <Button Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="{h:L Key=Common_RefreshF5}">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </StackPanel>
            </StackPanel>

            <InfoBar
                x:Name="ErrorInfo"
                Grid.Row="1"
                Margin="12,4"
                Severity="Error"
                IsOpen="{x:Bind h:Ui.HasText(ViewModel.ErrorMessage), Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                CloseButtonClick="OnErrorClosed"
                Visibility="{x:Bind ErrorInfo.IsOpen, Mode=OneWay}" />

            <controls:WeekGridView
                x:Name="WeekGrid"
                Grid.Row="2"
                Margin="4,0,8,0"
                Visibility="{x:Bind ViewModel.IsGridMode, Mode=OneWay}" />

            <Grid Grid.Row="2" Visibility="{x:Bind ViewModel.IsListMode, Mode=OneWay}">
                <TextBlock
                    Margin="0,48,0,0"
                    HorizontalAlignment="Center"
                    Text="{h:L Key=Calendar_NoEvents}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

                <ListView
                    ItemsSource="{x:Bind ViewModel.Events}"
                    SelectedItem="{x:Bind ViewModel.SelectedEvent, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CalendarEntryViewModel">
                            <StackPanel Padding="0,4">
                                <TextBlock
                                    Margin="0,8,0,6"
                                    Text="{x:Bind DayHeader}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Visibility="{x:Bind ShowDayHeader}" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Fill="{x:Bind h:Ui.Brush(StatusColor)}" RadiusX="2" RadiusY="2" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Padding="0,2"
                                        Text="{x:Bind TimeText}"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                    <StackPanel Grid.Column="2" Padding="0,2" Spacing="2">
                                        <TextBlock Text="{x:Bind Subject}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{x:Bind Location}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind HasLocation}" />
                                        <TextBlock
                                            Text="{x:Bind ResponseText}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <TextBlock
                Grid.Row="3"
                Margin="16,8"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!--  Details  -->
        <Grid
            Grid.Column="2"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,1,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <CommandBar HorizontalAlignment="Left" Background="Transparent" DefaultLabelPosition="Right">
                <!--  Only for events that link to an online meeting (see MeetingLink).  -->
                <AppBarButton
                    Click="OnJoinMeeting"
                    Icon="Video"
                    Label="{h:L Key=Meeting_Join}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Detail.JoinTooltip, Mode=OneWay, FallbackValue=''}"
                    Visibility="{x:Bind ViewModel.Detail.HasJoinUrl, Mode=OneWay, FallbackValue=Collapsed}" />
                <AppBarButton Icon="Edit" Label="{h:L Key=Common_Edit}" Command="{x:Bind ViewModel.EditCommand}" />
                <AppBarButton Icon="Accept" Label="{h:L Key=Meeting_Accept}" Command="{x:Bind ViewModel.RespondCommand}" CommandParameter="Accept" />
                <AppBarButton Label="{h:L Key=Response_Tentative}" Command="{x:Bind ViewModel.RespondCommand}" CommandParameter="Tentative">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE9CE;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Icon="Cancel" Label="{h:L Key=Meeting_Decline}" Command="{x:Bind ViewModel.RespondCommand}" CommandParameter="Decline" />
                <AppBarSeparator />
                <AppBarButton Icon="Delete" Label="{h:L Key=Calendar_DeleteOrCancel}" Command="{x:Bind ViewModel.DeleteCommand}" />
            </CommandBar>

            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind h:Ui.VisibleIfNot(ViewModel.HasDetail), Mode=OneWay}">
                <FontIcon Glyph="&#xE787;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="{h:L Key=Calendar_SelectEvent}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ProgressRing
                Grid.Row="1"
                Width="32"
                Height="32"
                IsActive="{x:Bind ViewModel.IsLoadingDetail, Mode=OneWay}" />

            <Grid
                Grid.Row="1"
                Padding="24,4,24,24"
                RowSpacing="12"
                Visibility="{x:Bind ViewModel.HasDetail, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="8">
                    <TextBlock
                        Text="{x:Bind ViewModel.Detail.Subject, Mode=OneWay}"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE823;" FontSize="14" />
                        <TextBlock Text="{x:Bind ViewModel.Detail.WhenText, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.Detail.HasLocation, Mode=OneWay, FallbackValue=Collapsed}">
                        <FontIcon Glyph="&#xE707;" FontSize="14" />
                        <TextBlock Text="{x:Bind ViewModel.Detail.Location, Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock
                        Text="{x:Bind ViewModel.Detail.OrganizerText, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Detail.ResponseText, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.Detail.HasAttendees, Mode=OneWay, FallbackValue=Collapsed}">
                        <Run Text="{h:L Key=Calendar_AttendeesLabel}" FontWeight="SemiBold" />
                        <Run Text="{x:Bind ViewModel.Detail.AttendeesText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.Detail.HasOptionalAttendees, Mode=OneWay, FallbackValue=Collapsed}">
                        <Run Text="{h:L Key=Calendar_OptionalLabel}" FontWeight="SemiBold" />
                        <Run Text="{x:Bind ViewModel.Detail.OptionalAttendeesText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <Border
                    Grid.Row="1"
                    Style="{StaticResource MessageBodyFrameStyle}">
                    <WebView2 x:Name="BodyView" />
                </Border>
            </Grid>
        </Grid>

        <!--  Splitters go last so they sit above the panes they overlap.  -->
        <toolkit:GridSplitter
            x:Name="SidebarSplitter"
            AutomationProperties.Name="{h:L Key=Common_ResizeColumn}"
            Grid.Column="1"
            Style="{StaticResource PaneSplitterStyle}" />
        <toolkit:GridSplitter
            x:Name="DetailSplitter"
            AutomationProperties.Name="{h:L Key=Common_ResizeColumn}"
            Grid.Column="2"
            Style="{StaticResource PaneSplitterStyle}" />
    </Grid>
</Page>
