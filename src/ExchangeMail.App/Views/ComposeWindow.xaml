<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ExchangeMail.App.Views.ComposeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:ExchangeMail.App.Helpers"
    xmlns:controls="using:ExchangeMail.App.Controls"
    xmlns:models="using:ExchangeMail.Core.Models">

    <Grid
        x:Name="Root"
        AllowDrop="True"
        DragLeave="OnDragLeave"
        DragOver="OnDragOver"
        Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarArea" Padding="16,0,0,0">
            <TextBlock
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.WindowTitle, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <CommandBar Grid.Row="1" HorizontalAlignment="Left" Background="Transparent" DefaultLabelPosition="Right">
            <AppBarButton Icon="Send" Label="{h:L Key=Compose_Send}" Command="{x:Bind ViewModel.SendCommand}">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton Icon="Attach" Label="{h:L Key=Compose_Attach}" Click="OnAttachClick" />
            <AppBarButton Icon="Save" Label="{h:L Key=Compose_SaveDraft}" Command="{x:Bind ViewModel.SaveDraftCommand}">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarToggleButton Icon="Important" Label="{h:L Key=Mail_HighImportance}" IsChecked="{x:Bind ViewModel.IsHighImportance, Mode=TwoWay}" />
            <AppBarToggleButton Label="{h:L Key=Compose_Bcc}" IsChecked="{x:Bind ViewModel.ShowBcc, Mode=TwoWay}">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE716;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
        </CommandBar>

        <StackPanel Grid.Row="2" Padding="16,0" Spacing="8">
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <InfoBar
                x:Name="ErrorInfo"
                Severity="Error"
                IsOpen="{x:Bind h:Ui.HasText(ViewModel.ErrorMessage), Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                CloseButtonClick="OnErrorClosed"
                Visibility="{x:Bind ErrorInfo.IsOpen, Mode=OneWay}" />
            <!--  Replies/forwards: the quoted original is on its way into the editor.  -->
            <ProgressBar
                IsIndeterminate="True"
                ToolTipService.ToolTip="{h:L Key=Compose_LoadingOriginal}"
                Visibility="{x:Bind ViewModel.IsLoadingOriginal, Mode=OneWay}" />
            <InfoBar
                x:Name="SavedInfo"
                Severity="Success"
                IsOpen="{x:Bind h:Ui.HasText(ViewModel.InfoMessage), Mode=OneWay}"
                Message="{x:Bind ViewModel.InfoMessage, Mode=OneWay}"
                IsClosable="False"
                Visibility="{x:Bind SavedInfo.IsOpen, Mode=OneWay}" />
        </StackPanel>

        <Grid
            Grid.Row="3"
            Padding="16,8"
            ColumnSpacing="12"
            RowSpacing="8">
            <Grid.ColumnDefinitions>
                <!--  As wide as the longest label, in either language and at any text size.  -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock VerticalAlignment="Center" Text="{h:L Key=Compose_To}" />
            <AutoSuggestBox
                x:Name="ToBox"
                Grid.Column="1"
                PlaceholderText="{h:L Key=Compose_RecipientsPlaceholder}"
                Text="{x:Bind ViewModel.To, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                UpdateTextOnSelect="False"
                TextChanged="OnRecipientTextChanged"
                QuerySubmitted="OnRecipientQuerySubmitted" />

            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="{h:L Key=Compose_Cc}" />
            <AutoSuggestBox
                x:Name="CcBox"
                Grid.Row="1"
                Grid.Column="1"
                Text="{x:Bind ViewModel.Cc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                UpdateTextOnSelect="False"
                TextChanged="OnRecipientTextChanged"
                QuerySubmitted="OnRecipientQuerySubmitted" />

            <TextBlock
                Grid.Row="2"
                VerticalAlignment="Center"
                Text="{h:L Key=Compose_Bcc}"
                Visibility="{x:Bind ViewModel.ShowBcc, Mode=OneWay}" />
            <AutoSuggestBox
                x:Name="BccBox"
                Grid.Row="2"
                Grid.Column="1"
                Text="{x:Bind ViewModel.Bcc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                UpdateTextOnSelect="False"
                TextChanged="OnRecipientTextChanged"
                QuerySubmitted="OnRecipientQuerySubmitted"
                Visibility="{x:Bind ViewModel.ShowBcc, Mode=OneWay}" />

            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="{h:L Key=Common_Subject}" />
            <TextBox
                Grid.Row="3"
                Grid.Column="1"
                Text="{x:Bind ViewModel.Subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Grid Grid.Row="4" Padding="16,0,16,8" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <controls:HtmlEditor x:Name="Editor" />
            <TextBlock
                Grid.Row="1"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis"
                Visibility="{x:Bind ViewModel.IsResponse, Mode=OneWay}">
                <Run Text="{h:L Key=Compose_OriginalAppended}" />
                <Run Text="{x:Bind ViewModel.OriginalSummary}" />
            </TextBlock>
        </Grid>

        <!--  Attachments have their own area; it lights up while files are dragged over the window.  -->
        <Border
            x:Name="AttachmentArea"
            Grid.Row="5"
            Margin="16,4,16,12"
            Padding="12,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Style="{StaticResource AttachmentAreaStyle}">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE723;" FontSize="14" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{x:Bind ViewModel.AttachmentsHeader, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <HyperlinkButton
                        Grid.Column="1"
                        Padding="4,0"
                        Command="{x:Bind ViewModel.AddOriginalAttachmentsCommand}"
                        Content="{x:Bind ViewModel.AddOriginalAttachmentsText}"
                        Visibility="{x:Bind ViewModel.CanAddOriginalAttachments, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Text="{h:L Key=Compose_DropHere}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <ListView
                    MaxHeight="80"
                    ItemsSource="{x:Bind ViewModel.ExistingAttachments}"
                    SelectionMode="None"
                    Visibility="{x:Bind ViewModel.HasExistingAttachments, Mode=OneWay}">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:AttachmentInfo">
                            <Grid
                                Width="220"
                                Padding="8,4"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                ColumnSpacing="8"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE723;" FontSize="16" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <Button
                                    Grid.Column="2"
                                    Padding="4"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OnRemoveExistingAttachment"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="{h:L Key=Compose_RemoveFromDraft}">
                                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ListView
                    MaxHeight="120"
                    ItemsSource="{x:Bind ViewModel.Attachments}"
                    SelectionMode="None"
                    Visibility="{x:Bind ViewModel.HasNewAttachments, Mode=OneWay}">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:OutgoingAttachment">
                            <Grid
                                Width="220"
                                Padding="8,4"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                ColumnSpacing="8"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8A5;" FontSize="16" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <Button
                                    Grid.Column="2"
                                    Padding="4"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OnRemoveAttachment"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="{h:L Key=Common_Remove}">
                                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>
    </Grid>
</Window>
