<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ExchangeMail.App.Views.MailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:ExchangeMail.App.Helpers"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:ExchangeMail.ViewModels"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="FolderColumn" Width="260" MinWidth="180" MaxWidth="480" />
            <ColumnDefinition x:Name="ListColumn" Width="400" MinWidth="280" MaxWidth="900" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Folders. The top padding puts New mail level with the search box of the list next to it.  -->
        <Grid Padding="8,8,8,8" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="4,4,4,12" Orientation="Horizontal" Spacing="8">
                <Button
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.NewMailCommand}"
                    ToolTipService.ToolTip="{h:L Key=Mail_NewTooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="{h:L Key=Mail_New}" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                </Button>
                <!--  Disabled while running (async commands don't overlap), which doubles as progress feedback.
                      Stretch: as tall as the New mail button next to it.  -->
                <Button
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="{h:L Key=Mail_SendReceive}"
                    Command="{x:Bind ViewModel.SendReceiveCommand}"
                    ToolTipService.ToolTip="{h:L Key=Mail_SendReceiveTooltip}">
                    <FontIcon Glyph="&#xE895;" FontSize="14" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F9" />
                    </Button.KeyboardAccelerators>
                </Button>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="12,0,0,8">
                <TextBlock Text="{x:Bind ViewModel.AccountEmail}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind ViewModel.ServerHost}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!--  Right padding keeps the counts clear of the scroll bar.  -->
            <ListView
                x:Name="FolderList"
                Grid.Row="2"
                Padding="0,0,12,0"
                ItemsSource="{x:Bind ViewModel.Folders}"
                SelectedItem="{x:Bind ViewModel.SelectedFolder, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FolderViewModel">
                        <!--  A drop target for messages dragged from the list (the style gives it a background, see OnFolderDragOver).  -->
                        <!--  Row height comes from the item container (compact or comfortable, see ApplyFolderDensity).  -->
                        <Grid
                            Padding="{x:Bind h:Ui.Indent(Depth)}"
                            AllowDrop="True"
                            Style="{StaticResource FolderRowStyle}"
                            ColumnSpacing="12"
                            DragLeave="OnFolderDragLeave"
                            DragOver="OnFolderDragOver"
                            Drop="OnFolderDrop">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Bind DisplayName}"
                                FontWeight="{x:Bind h:Ui.BoldIf(HasUnread), Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Text="{x:Bind UnreadText, Mode=OneWay}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!--  Message list  -->
        <Grid
            Grid.Column="1"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,1,0,0"
            CornerRadius="8,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Padding="12,12,12,4" Spacing="8">
                <AutoSuggestBox
                    x:Name="SearchBox"
                    PlaceholderText="{h:L Key=Mail_SearchPlaceholder}"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                    QuerySubmitted="OnSearchSubmitted">
                    <AutoSuggestBox.KeyboardAccelerators>
                        <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="OnFocusSearch" />
                    </AutoSuggestBox.KeyboardAccelerators>
                </AutoSuggestBox>
                <Grid>
                    <TextBlock
                        Text="{x:Bind ViewModel.SelectedFolder.DisplayName, Mode=OneWay}"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                        <HyperlinkButton
                            Content="{h:L Key=Mail_ClearSearch}"
                            Command="{x:Bind ViewModel.ClearSearchCommand}"
                            Visibility="{x:Bind ViewModel.IsSearchActive, Mode=OneWay}" />
                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsLoadingList, Mode=OneWay}" />
                        <ToggleButton
                            Padding="8,4"
                            AutomationProperties.Name="{h:L Key=Mail_ConversationView}"
                            IsChecked="{x:Bind ViewModel.IsConversationView, Mode=TwoWay}"
                            ToolTipService.ToolTip="{h:L Key=Mail_ConversationView}">
                            <FontIcon Glyph="&#xE8F2;" FontSize="14" />
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <InfoBar
                x:Name="ErrorInfo"
                Grid.Row="1"
                Margin="12,4"
                Severity="Error"
                IsOpen="{x:Bind h:Ui.HasText(ViewModel.ErrorMessage), Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                CloseButtonClick="OnErrorClosed"
                Visibility="{x:Bind ErrorInfo.IsOpen, Mode=OneWay}" />

            <TextBlock
                Grid.Row="2"
                Margin="0,48,0,0"
                HorizontalAlignment="Center"
                Text="{h:L Key=Mail_Empty}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="{x:Bind ViewModel.IsListEmpty, Mode=OneWay}" />

            <!--
                Extended selection: Ctrl/Shift-click and Ctrl+A. The selection is synced with the view model in code-behind
                (SelectedItem can only carry one row). Dragged rows can be dropped on a folder.
            -->
            <ListView
                x:Name="MessageList"
                Grid.Row="2"
                CanDragItems="True"
                CanReorderItems="False"
                ItemsSource="{x:Bind ViewModel.Messages}"
                SelectionMode="Extended"
                DoubleTapped="OnMessageDoubleTapped"
                DragItemsCompleted="OnMessagesDragCompleted"
                DragItemsStarting="OnMessagesDragStarting"
                KeyDown="OnMessageListKeyDown"
                SelectionChanged="OnMessageSelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MessageItemViewModel">
                        <!--
                            Conversation view: a chevron opens the conversation, and its messages follow indented (IndentWidth),
                            without repeating the subject.
                        -->
                        <Grid Margin="{x:Bind h:Ui.LeftMargin(IndentWidth)}" Padding="0,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle
                                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                RadiusX="1.5"
                                RadiusY="1.5"
                                Visibility="{x:Bind IsUnread, Mode=OneWay}" />
                            <Grid Grid.Column="1" Width="24" Visibility="{x:Bind HasExpanderColumn}">
                                <Button
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    VerticalAlignment="Top"
                                    AutomationProperties.Name="{h:L Key=Mail_ShowConversation}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OnToggleConversation"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="{h:L Key=Mail_ShowConversation}"
                                    Visibility="{x:Bind CanExpand}">
                                    <FontIcon Glyph="{x:Bind ExpandGlyph, Mode=OneWay}" FontSize="10" />
                                </Button>
                            </Grid>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="{x:Bind Sender}"
                                        FontWeight="{x:Bind h:Ui.BoldIf(IsUnread), Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <FontIcon
                                        Grid.Column="1"
                                        Glyph="&#xE787;"
                                        FontSize="12"
                                        ToolTipService.ToolTip="{h:L Key=Mail_Meeting}"
                                        Visibility="{x:Bind IsMeeting}" />
                                    <FontIcon
                                        Grid.Column="2"
                                        Glyph="&#xE8C9;"
                                        FontSize="12"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        ToolTipService.ToolTip="{h:L Key=Mail_HighImportance}"
                                        Visibility="{x:Bind IsHighImportance}" />
                                    <FontIcon
                                        Grid.Column="3"
                                        Glyph="&#xE723;"
                                        FontSize="12"
                                        ToolTipService.ToolTip="{h:L Key=Mail_HasAttachment}"
                                        Visibility="{x:Bind HasAttachments}" />
                                    <!--  Number of messages in the conversation.  -->
                                    <Border
                                        Grid.Column="4"
                                        Padding="6,0"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="8"
                                        Visibility="{x:Bind HasCount}">
                                        <TextBlock Text="{x:Bind CountText}" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="5"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind DateText}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <TextBlock
                                    Text="{x:Bind Subject}"
                                    FontWeight="{x:Bind h:Ui.BoldIf(IsUnread), Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{x:Bind ShowSubject}" />
                                <TextBlock
                                    Text="{x:Bind Preview}"
                                    Visibility="{x:Bind HasPreview}"
                                    MaxLines="1"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <Button
                        Margin="0,8,0,16"
                        HorizontalAlignment="Center"
                        Content="{h:L Key=Common_LoadMore}"
                        Command="{x:Bind ViewModel.LoadMoreCommand}"
                        Visibility="{x:Bind ViewModel.HasMore, Mode=OneWay}" />
                </ListView.Footer>
            </ListView>

            <TextBlock
                Grid.Row="3"
                Margin="16,8"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!--  Reading pane  -->
        <Grid
            Grid.Column="2"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,1,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <CommandBar HorizontalAlignment="Left" Background="Transparent" DefaultLabelPosition="Right">
                <AppBarButton
                    Icon="Edit"
                    Label="{h:L Key=Mail_EditDraft}"
                    Command="{x:Bind ViewModel.EditDraftCommand}"
                    Visibility="{x:Bind ViewModel.IsDraftsFolder, Mode=OneWay}" />
                <AppBarButton Icon="MailReply" Label="{h:L Key=Mail_Reply}" Command="{x:Bind ViewModel.ReplyCommand}">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="R" Modifiers="Control" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton Icon="MailReplyAll" Label="{h:L Key=Mail_ReplyAll}" Command="{x:Bind ViewModel.ReplyAllCommand}">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="R" Modifiers="Control,Shift" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton Icon="MailForward" Label="{h:L Key=Mail_Forward}" Command="{x:Bind ViewModel.ForwardCommand}">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" Modifiers="Control" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Icon="Delete" Label="{h:L Key=Common_Delete}" Command="{x:Bind ViewModel.DeleteCommand}" />
                <AppBarButton Icon="MoveToFolder" Label="{h:L Key=Mail_Move}" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="MoveFlyout" Opening="OnMoveFlyoutOpening" />
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton Icon="Read" Label="{h:L Key=Mail_ToggleRead}" Command="{x:Bind ViewModel.ToggleReadCommand}">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Q" Modifiers="Control" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton Icon="Refresh" Label="{h:L Key=Common_Refresh}" Command="{x:Bind ViewModel.RefreshCommand}">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
            </CommandBar>

            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.ShowPlaceholder, Mode=OneWay}">
                <FontIcon Glyph="&#xE715;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.PlaceholderText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ProgressRing
                Grid.Row="1"
                Width="32"
                Height="32"
                IsActive="{x:Bind ViewModel.IsLoadingMessage, Mode=OneWay}" />

            <!--
                Everything above the body sits in one panel: collapsed parts (no attachments, closed info bars) leave no
                gap, which separate grid rows with RowSpacing would.
            -->
            <Grid
                Grid.Row="1"
                Padding="24,4,24,24"
                RowSpacing="12"
                Visibility="{x:Bind ViewModel.HasCurrent, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                Glyph="&#xE8C9;"
                                FontSize="16"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Visibility="{x:Bind ViewModel.Current.IsHighImportance, Mode=OneWay, FallbackValue=Collapsed}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.Current.Subject, Mode=OneWay}"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind ViewModel.Current.ThreadText, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="{x:Bind ViewModel.Current.IsThread, Mode=OneWay, FallbackValue=Collapsed}" />
                    </StackPanel>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!--  Only while messages are shown dark (see UpdateLightBackgroundButton); applies to the open message.  -->
                        <ToggleButton
                            x:Name="LightBackgroundButton"
                            Grid.Column="2"
                            VerticalAlignment="Top"
                            Click="OnLightBackgroundClick"
                            ToolTipService.ToolTip="{h:L Key=Mail_LightBackground}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE706;" FontSize="14" />
                                <TextBlock Text="{h:L Key=Mail_LightBackground}" />
                            </StackPanel>
                        </ToggleButton>
                        <PersonPicture
                            x:Name="SenderPicture"
                            Width="40"
                            Height="40"
                            VerticalAlignment="Top"
                            Tapped="OnSenderPictureTapped"
                            DisplayName="{x:Bind ViewModel.Current.FromName, Mode=OneWay}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!--  Names are links (built in code-behind) that open a card with the person's place in the directory.  -->
                                <HyperlinkButton
                                    x:Name="FromButton"
                                    Padding="0"
                                    Click="OnFromClicked"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                                    <TextBlock Text="{x:Bind ViewModel.Current.FromName, Mode=OneWay}" FontWeight="SemiBold" />
                                </HyperlinkButton>
                                <TextBlock Text="{x:Bind ViewModel.Current.FromAddress, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{h:L Key=Mail_ToLabel}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ToLine" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            </Grid>
                            <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.Current.HasCc, Mode=OneWay, FallbackValue=Collapsed}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{h:L Key=Mail_CcLabel}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="CcLine" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.Current.DateText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <!--  No bottom padding (the default style reserves 10 px below the items).  -->
                    <GridView
                        MaxHeight="140"
                        Padding="0"
                        IsItemClickEnabled="True"
                        ItemClick="OnAttachmentClick"
                        ItemsSource="{x:Bind ViewModel.Current.Attachments, Mode=OneWay}"
                        SelectionMode="None"
                        ToolTipService.ToolTip="{h:L Key=Mail_ClickToSave}"
                        Visibility="{x:Bind ViewModel.Current.HasAttachments, Mode=OneWay, FallbackValue=Collapsed}">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:AttachmentViewModel">
                                <Grid
                                    Width="220"
                                    Padding="8,4"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    ColumnSpacing="8"
                                    CornerRadius="{StaticResource ControlCornerRadius}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind SizeText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    <InfoBar
                        x:Name="MeetingBar"
                        Title="{h:L Key=Mail_MeetingInvitation}"
                        Severity="Informational"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.IsMeetingRequest, Mode=OneWay}"
                        Visibility="{x:Bind MeetingBar.IsOpen, Mode=OneWay}"
                        Message="{h:L Key=Mail_MeetingInvitationHint}">
                        <InfoBar.Content>
                            <StackPanel Margin="0,0,0,12" Orientation="Horizontal" Spacing="8">
                                <Button
                                    Content="{h:L Key=Meeting_Accept}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.RespondToMeetingCommand}"
                                    CommandParameter="Accept" />
                                <Button Content="{h:L Key=Response_Tentative}" Command="{x:Bind ViewModel.RespondToMeetingCommand}" CommandParameter="Tentative" />
                                <Button Content="{h:L Key=Meeting_Decline}" Command="{x:Bind ViewModel.RespondToMeetingCommand}" CommandParameter="Decline" />
                            </StackPanel>
                        </InfoBar.Content>
                    </InfoBar>
                    <InfoBar
                        x:Name="RemoteContentBar"
                        Severity="Informational"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.Current.ShowRemoteContentBanner, Mode=OneWay, FallbackValue=False}"
                        Visibility="{x:Bind RemoteContentBar.IsOpen, Mode=OneWay}"
                        Message="{h:L Key=Mail_RemoteImagesBlocked}">
                        <InfoBar.ActionButton>
                            <Button Content="{h:L Key=Mail_ShowImages}" Click="OnShowRemoteContent" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>

                <Border
                    Grid.Row="1"
                    Background="Transparent"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <WebView2 x:Name="BodyView" />
                </Border>
            </Grid>
        </Grid>

        <!--  Splitters go last so they sit above the panes they overlap.  -->
        <toolkit:GridSplitter
            x:Name="FolderSplitter"
            AutomationProperties.Name="{h:L Key=Common_ResizeColumn}"
            Grid.Column="1"
            Style="{StaticResource PaneSplitterStyle}" />
        <toolkit:GridSplitter
            x:Name="ListSplitter"
            AutomationProperties.Name="{h:L Key=Common_ResizeColumn}"
            Grid.Column="2"
            Style="{StaticResource PaneSplitterStyle}" />
    </Grid>
</Page>
