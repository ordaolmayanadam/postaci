<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ExchangeMail.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:ExchangeMail.App.Helpers">

    <NavigationView
        x:Name="Nav"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="True"
        IsSettingsVisible="True"
        OpenPaneLength="220"
        PaneDisplayMode="LeftCompact"
        SelectionChanged="OnNavigationSelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="MailItem" Content="{h:L Key=Nav_Mail}" Icon="Mail" Tag="mail">
                <NavigationViewItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="OnNavigationAccelerator" />
                </NavigationViewItem.KeyboardAccelerators>
            </NavigationViewItem>
            <NavigationViewItem x:Name="CalendarItem" Content="{h:L Key=Nav_Calendar}" Icon="Calendar" Tag="calendar">
                <NavigationViewItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="OnNavigationAccelerator" />
                </NavigationViewItem.KeyboardAccelerators>
            </NavigationViewItem>
            <NavigationViewItem x:Name="ContactsItem" Content="{h:L Key=Nav_Contacts}" Icon="People" Tag="contacts">
                <NavigationViewItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="OnNavigationAccelerator" />
                </NavigationViewItem.KeyboardAccelerators>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <InfoBar
                x:Name="AutoReplyBanner"
                Margin="8,0,8,8"
                IsClosable="False"
                IsOpen="{x:Bind AutoReply.IsActive, Mode=OneWay}"
                Message="{x:Bind AutoReply.BannerText, Mode=OneWay}"
                Severity="Warning"
                Visibility="{x:Bind AutoReplyBanner.IsOpen, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="{h:L Key=AutoReply_TurnOff}" Command="{x:Bind AutoReply.TurnOffCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <Frame x:Name="ContentFrame" Grid.Row="1" />
        </Grid>
    </NavigationView>
</Page>
