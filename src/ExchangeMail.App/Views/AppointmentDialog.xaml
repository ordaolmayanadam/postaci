<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ExchangeMail.App.Views.AppointmentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:ExchangeMail.App.Helpers"
    xmlns:controls="using:ExchangeMail.App.Controls"
    Title="{h:L Key=Calendar_NewEvent}"
    CloseButtonText="{h:L Key=Common_Cancel}"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonText="{h:L Key=Common_Save}">

    <ContentDialog.Resources>
        <!--  The default limit (548) is too narrow for the availability timeline.  -->
        <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="560" Padding="0,0,12,0" Spacing="12">
            <InfoBar
                x:Name="SeriesBar"
                IsClosable="False"
                Message="{h:L Key=Appointment_SeriesHint}"
                Severity="Informational"
                Visibility="{x:Bind SeriesBar.IsOpen, Mode=OneWay}" />
            <TextBox x:Name="SubjectBox" Header="{h:L Key=Common_Subject}" />
            <TextBox x:Name="LocationBox" Header="{h:L Key=Appointment_Location}" PlaceholderText="{h:L Key=Appointment_LocationPlaceholder}" />
            <CheckBox x:Name="AllDayCheck" Checked="OnAllDayChanged" Content="{h:L Key=Calendar_AllDay}" Unchecked="OnAllDayChanged" />

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <CalendarDatePicker x:Name="StartDate" HorizontalAlignment="Stretch" Header="{h:L Key=Appointment_StartDate}" />
                <TimePicker x:Name="StartTime" Grid.Column="1" HorizontalAlignment="Stretch" ClockIdentifier="24HourClock" Header="{h:L Key=Common_Time}" MinuteIncrement="15" />
                <CalendarDatePicker x:Name="EndDate" Grid.Row="1" HorizontalAlignment="Stretch" Header="{h:L Key=Appointment_EndDate}" />
                <TimePicker x:Name="EndTime" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ClockIdentifier="24HourClock" Header="{h:L Key=Common_Time}" MinuteIncrement="15" />
            </Grid>

            <!--  New events only: a series keeps the pattern it was created with.  -->
            <Grid x:Name="RepeatRow" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="RepeatBox" HorizontalAlignment="Stretch" Header="{h:L Key=Appointment_Repeat}" SelectionChanged="OnRepeatChanged" />
                <CalendarDatePicker
                    x:Name="RepeatUntilDate"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Header="{h:L Key=Appointment_RepeatUntil}"
                    IsEnabled="False"
                    PlaceholderText="{h:L Key=Appointment_RepeatUntilPlaceholder}" />
            </Grid>

            <TextBox
                x:Name="AttendeesBox"
                Header="{h:L Key=Appointment_Attendees}"
                Description="{h:L Key=Appointment_AttendeesHint}"
                PlaceholderText="{h:L Key=Appointment_AttendeesPlaceholder}" />

            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="OnShowAvailability" Content="{h:L Key=Appointment_ShowAvailability}" />
                    <ProgressRing x:Name="AvailabilityRing" Width="16" Height="16" IsActive="False" />
                    <TextBlock
                        x:Name="AvailabilityHint"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{h:L Key=Appointment_AvailabilityHint}" />
                </StackPanel>
                <controls:AvailabilityView x:Name="Availability" Visibility="Collapsed" />
            </StackPanel>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ReminderBox" HorizontalAlignment="Stretch" Header="{h:L Key=Appointment_Reminder}" SelectedIndex="2">
                    <ComboBoxItem Content="{h:L Key=Appointment_ReminderNone}" />
                    <ComboBoxItem Content="{h:L Key=Appointment_Reminder5}" />
                    <ComboBoxItem Content="{h:L Key=Appointment_Reminder15}" />
                    <ComboBoxItem Content="{h:L Key=Appointment_Reminder30}" />
                    <ComboBoxItem Content="{h:L Key=Appointment_Reminder60}" />
                    <ComboBoxItem Content="{h:L Key=Appointment_Reminder1440}" />
                </ComboBox>
                <ComboBox x:Name="ShowAsBox" Grid.Column="1" HorizontalAlignment="Stretch" Header="{h:L Key=Appointment_ShowAs}" SelectedIndex="2">
                    <ComboBoxItem Content="{h:L Key=FreeBusy_Free}" />
                    <ComboBoxItem Content="{h:L Key=Response_Tentative}" />
                    <ComboBoxItem Content="{h:L Key=FreeBusy_Busy}" />
                    <ComboBoxItem Content="{h:L Key=FreeBusy_Away}" />
                </ComboBox>
            </Grid>

            <TextBox
                x:Name="BodyBox"
                Height="110"
                AcceptsReturn="True"
                Header="{h:L Key=Appointment_Description}"
                TextWrapping="Wrap" />

            <InfoBar x:Name="ErrorBar" IsClosable="False" Severity="Error" Visibility="{x:Bind ErrorBar.IsOpen, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
