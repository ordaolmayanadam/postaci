<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ExchangeMail.App.Views.AppointmentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ExchangeMail.App.Controls"
    Title="Yeni etkinlik"
    CloseButtonText="İptal"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonText="Kaydet">

    <ContentDialog.Resources>
        <!--  The default limit (548) is too narrow for the availability timeline.  -->
        <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="560" Padding="0,0,12,0" Spacing="12">
            <TextBox x:Name="SubjectBox" Header="Konu" />
            <TextBox x:Name="LocationBox" Header="Konum" PlaceholderText="Toplantı odası veya adres" />
            <CheckBox x:Name="AllDayCheck" Checked="OnAllDayChanged" Content="Tüm gün" Unchecked="OnAllDayChanged" />

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <CalendarDatePicker x:Name="StartDate" HorizontalAlignment="Stretch" Header="Başlangıç tarihi" />
                <TimePicker x:Name="StartTime" Grid.Column="1" HorizontalAlignment="Stretch" ClockIdentifier="24HourClock" Header="Saat" MinuteIncrement="15" />
                <CalendarDatePicker x:Name="EndDate" Grid.Row="1" HorizontalAlignment="Stretch" Header="Bitiş tarihi" />
                <TimePicker x:Name="EndTime" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ClockIdentifier="24HourClock" Header="Saat" MinuteIncrement="15" />
            </Grid>

            <TextBox
                x:Name="AttendeesBox"
                Header="Katılımcılar"
                Description="Adres girerseniz toplantı daveti gönderilir. Birden fazlasını ; ile ayırın."
                PlaceholderText="ad.soyad@sirket.com.tr; ..." />

            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="OnShowAvailability" Content="Uygunluğu göster" />
                    <ProgressRing x:Name="AvailabilityRing" Width="16" Height="16" IsActive="False" />
                    <TextBlock
                        x:Name="AvailabilityHint"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Sizin ve katılımcıların seçili gündeki meşgul saatleri" />
                </StackPanel>
                <controls:AvailabilityView x:Name="Availability" Visibility="Collapsed" />
            </StackPanel>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ReminderBox" HorizontalAlignment="Stretch" Header="Anımsatıcı" SelectedIndex="2">
                    <ComboBoxItem Content="Yok" />
                    <ComboBoxItem Content="5 dakika önce" />
                    <ComboBoxItem Content="15 dakika önce" />
                    <ComboBoxItem Content="30 dakika önce" />
                    <ComboBoxItem Content="1 saat önce" />
                    <ComboBoxItem Content="1 gün önce" />
                </ComboBox>
                <ComboBox x:Name="ShowAsBox" Grid.Column="1" HorizontalAlignment="Stretch" Header="Durumum" SelectedIndex="2">
                    <ComboBoxItem Content="Boş" />
                    <ComboBoxItem Content="Belki" />
                    <ComboBoxItem Content="Meşgul" />
                    <ComboBoxItem Content="Dışarıda" />
                </ComboBox>
            </Grid>

            <TextBox
                x:Name="BodyBox"
                Height="110"
                AcceptsReturn="True"
                Header="Açıklama"
                TextWrapping="Wrap" />

            <InfoBar x:Name="ErrorBar" IsClosable="False" Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
