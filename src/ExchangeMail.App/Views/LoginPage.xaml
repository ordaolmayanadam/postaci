<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ExchangeMail.App.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:ExchangeMail.App.Helpers">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid
            Width="460"
            Margin="24"
            Padding="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal" Spacing="12">
                        <Image Width="40" Height="40" Source="ms-appx:///Assets/Postaci-256.png" />
                        <TextBlock VerticalAlignment="Center" Text="Postacı" Style="{StaticResource TitleTextBlockStyle}" />
                    </StackPanel>
                    <TextBlock Text="{h:L Key=Login_Title}" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="{h:L Key=Login_Subtitle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <TextBox
                    Header="{h:L Key=Login_EmailAddress}"
                    PlaceholderText="{h:L Key=Login_EmailPlaceholder}"
                    InputScope="EmailSmtpAddress"
                    Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <ToggleSwitch
                    Header="{h:L Key=Login_Authentication}"
                    OnContent="{h:L Key=Login_UseWindows}"
                    OffContent="{h:L Key=Login_UserPassword}"
                    IsOn="{x:Bind ViewModel.UseWindowsAuth, Mode=TwoWay}" />

                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsPasswordLogin, Mode=OneWay}">
                    <TextBox
                        Header="{h:L Key=Login_UserName}"
                        PlaceholderText="{h:L Key=Login_UserNamePlaceholder}"
                        Text="{x:Bind ViewModel.UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <PasswordBox
                        x:Name="PasswordInput"
                        Header="{h:L Key=Login_Password}"
                        KeyDown="OnPasswordKeyDown"
                        PasswordChanged="OnPasswordChanged" />
                    <CheckBox
                        Content="{h:L Key=Login_RememberPassword}"
                        IsChecked="{x:Bind ViewModel.RememberPassword, Mode=TwoWay}" />
                </StackPanel>

                <Expander
                    Header="{h:L Key=Login_Advanced}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <TextBox
                        Header="{h:L Key=Login_EwsUrl}"
                        PlaceholderText="{h:L Key=Login_EwsUrlPlaceholder}"
                        Description="{h:L Key=Login_EwsUrlHint}"
                        Text="{x:Bind ViewModel.EwsUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Expander>

                <InfoBar
                    Severity="Error"
                    IsClosable="False"
                    IsOpen="{x:Bind h:Ui.HasText(ViewModel.ErrorMessage), Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        MinWidth="120"
                        Content="{h:L Key=Login_Connect}"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.ConnectCommand}" />
                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
