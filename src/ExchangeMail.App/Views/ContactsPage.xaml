<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ExchangeMail.App.Views.ContactsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:ExchangeMail.App.Helpers"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:ExchangeMail.ViewModels"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="400" MinWidth="320" MaxWidth="900" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--
            List. Like the folder pane and the month view, the first column sits on the navigation view's own content
            layer; a layer of its own drew a second card in the same corner.
        -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Padding="12,12,12,4" Spacing="8">
                <!--  Like New mail and New event: no page title, the new-item button at the top left.  -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        Click="OnNewContact"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="{h:L Key=Contacts_NewTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="{h:L Key=Contacts_New}" />
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="N" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                </StackPanel>
                <RadioButtons MaxColumns="2" SelectedIndex="{x:Bind ViewModel.SourceIndex, Mode=TwoWay}">
                    <RadioButton Content="{h:L Key=Contacts_Mine}" />
                    <RadioButton Content="{h:L Key=Contacts_Directory}" />
                </RadioButtons>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
                    QueryIcon="Find"
                    QuerySubmitted="OnSearchSubmitted"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
            </StackPanel>

            <InfoBar
                x:Name="ErrorInfo"
                Grid.Row="1"
                Margin="12,4"
                Severity="Error"
                IsOpen="{x:Bind h:Ui.HasText(ViewModel.ErrorMessage), Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                CloseButtonClick="OnErrorClosed"
                Visibility="{x:Bind ErrorInfo.IsOpen, Mode=OneWay}" />

            <TextBlock
                Grid.Row="2"
                Margin="24,48,24,0"
                HorizontalAlignment="Center"
                Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

            <ListView
                Grid.Row="2"
                ItemsSource="{x:Bind ViewModel.Contacts}"
                SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ContactItemViewModel">
                        <Grid Padding="0,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <PersonPicture Width="32" Height="32" DisplayName="{x:Bind DisplayName}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="{x:Bind ListSecondLine}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <Button
                        Margin="0,8,0,16"
                        HorizontalAlignment="Center"
                        Content="{h:L Key=Common_LoadMore}"
                        Command="{x:Bind ViewModel.LoadMoreCommand}"
                        Visibility="{x:Bind ViewModel.HasMore, Mode=OneWay}" />
                </ListView.Footer>
            </ListView>

            <TextBlock
                Grid.Row="3"
                Margin="16,8"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </Grid>

        <!--  Details: actions in a command bar, as in the mail and calendar reading panes.  -->
        <Grid
            Grid.Column="1"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,1,0,0"
            CornerRadius="8,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <CommandBar
                HorizontalAlignment="Left"
                Background="Transparent"
                DefaultLabelPosition="Right"
                Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                <AppBarButton Icon="Mail" Label="{h:L Key=Contacts_SendEmail}" Command="{x:Bind ViewModel.SendMailCommand}" />
                <AppBarButton
                    Icon="AddFriend"
                    Label="{h:L Key=Contacts_AddToMine}"
                    Command="{x:Bind ViewModel.AddToContactsCommand}"
                    Visibility="{x:Bind ViewModel.Selected.IsDirectoryEntry, Mode=OneWay, FallbackValue=Collapsed}" />
                <AppBarButton
                    Icon="Edit"
                    Label="{h:L Key=Common_Edit}"
                    Command="{x:Bind ViewModel.EditCommand}"
                    Visibility="{x:Bind h:Ui.VisibleIfNot(ViewModel.IsDirectory), Mode=OneWay}" />
                <AppBarButton
                    Icon="Delete"
                    Label="{h:L Key=Common_Delete}"
                    Command="{x:Bind ViewModel.DeleteCommand}"
                    Visibility="{x:Bind h:Ui.VisibleIfNot(ViewModel.IsDirectory), Mode=OneWay}" />
            </CommandBar>

            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind h:Ui.VisibleIfNot(ViewModel.HasSelection), Mode=OneWay}">
                <FontIcon Glyph="&#xE716;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="{h:L Key=Contacts_SelectContact}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                <!--  The card fills the pane up to 640 px of content, aligned left, whatever the length of its lines.  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="688" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Padding="24,4,24,24" Spacing="24">
                        <!--
                            A contact card: name with title, department and company each on a line of its own, then the
                            ways to reach the person. Every line wraps, so long names and titles fit; empty ones are hidden.
                        -->
                        <Border
                            Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource OverlayCornerRadius}">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <PersonPicture Width="72" Height="72" VerticalAlignment="Top" DisplayName="{x:Bind ViewModel.Selected.DisplayName, Mode=OneWay}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            Text="{x:Bind ViewModel.Selected.DisplayName, Mode=OneWay}"
                                            Style="{StaticResource SubtitleTextBlockStyle}"
                                            IsTextSelectionEnabled="True"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.Selected.JobTitle, Mode=OneWay}"
                                            IsTextSelectionEnabled="True"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind ViewModel.Selected.HasJobTitle, Mode=OneWay, FallbackValue=Collapsed}" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.Selected.Department, Mode=OneWay}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            IsTextSelectionEnabled="True"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind ViewModel.Selected.HasDepartment, Mode=OneWay, FallbackValue=Collapsed}" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.Selected.Company, Mode=OneWay}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            IsTextSelectionEnabled="True"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind ViewModel.Selected.HasCompany, Mode=OneWay, FallbackValue=Collapsed}" />
                                    </StackPanel>
                                </Grid>

                                <Border
                                    Height="1"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    Visibility="{x:Bind ViewModel.Selected.HasContactDetails, Mode=OneWay, FallbackValue=Collapsed}" />

                                <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.Selected.HasEmail, Mode=OneWay, FallbackValue=Collapsed}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon VerticalAlignment="Center" Glyph="&#xE715;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{h:L Key=Common_Email}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.Selected.Email, Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.Selected.HasBusinessPhone, Mode=OneWay, FallbackValue=Collapsed}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon VerticalAlignment="Center" Glyph="&#xE717;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{h:L Key=Contacts_BusinessPhone}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.Selected.BusinessPhone, Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.Selected.HasMobilePhone, Mode=OneWay, FallbackValue=Collapsed}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon VerticalAlignment="Center" Glyph="&#xE8EA;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{h:L Key=Contacts_MobilePhone}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.Selected.MobilePhone, Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!--  Splitters go last so they sit above the panes they overlap.  -->
        <toolkit:GridSplitter
            x:Name="ListSplitter"
            AutomationProperties.Name="{h:L Key=Common_ResizeColumn}"
            Grid.Column="1"
            Style="{StaticResource PaneSplitterStyle}" />
    </Grid>
</Page>
