<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ExchangeMail.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ExchangeMail.App.Controls"
    xmlns:h="using:ExchangeMail.App.Helpers"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Grid">
            <Setter Property="Padding" Value="16" />
            <Setter Property="ColumnSpacing" Value="24" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SectionStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="4,20,0,4" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" Padding="32,8,32,32" HorizontalAlignment="Stretch" Spacing="6">
            <TextBlock Text="Ayarlar" Style="{StaticResource TitleTextBlockStyle}" />

            <InfoBar
                Severity="Error"
                IsOpen="{x:Bind h:Ui.HasText(ViewModel.ErrorMessage), Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                IsClosable="False" />
            <InfoBar
                Severity="Success"
                IsOpen="{x:Bind h:Ui.HasText(ViewModel.InfoMessage), Mode=OneWay}"
                Message="{x:Bind ViewModel.InfoMessage, Mode=OneWay}"
                IsClosable="False" />

            <!--  Mail  -->
            <TextBlock Text="Posta" Style="{StaticResource SectionStyle}" />

            <Grid Style="{StaticResource CardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="İletiyi okundu olarak işaretle" />
                    <TextBlock
                        Text="Okuma bölmesinde açılan okunmamış ileti ne zaman okundu sayılsın?"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                    <ComboBox MinWidth="200" SelectedIndex="{x:Bind ViewModel.MarkAsReadIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Seçildiğinde" />
                        <ComboBoxItem Content="Birkaç saniye sonra" />
                        <ComboBoxItem Content="Hiçbir zaman (elle)" />
                    </ComboBox>
                    <NumberBox
                        Width="130"
                        IsEnabled="{x:Bind ViewModel.IsDelayEnabled, Mode=OneWay}"
                        Maximum="120"
                        Minimum="1"
                        PlaceholderText="sn"
                        SpinButtonPlacementMode="Inline"
                        ToolTipService.ToolTip="Saniye"
                        Value="{x:Bind ViewModel.MarkAsReadDelaySeconds, Mode=TwoWay}" />
                </StackPanel>
            </Grid>

            <Grid Style="{StaticResource CardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Yeni posta denetimi" />
                    <TextBlock
                        Text="Gelen kutusu ve klasör sayıları bu aralıkla yenilenir."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ComboBox Grid.Column="1" MinWidth="200" SelectedIndex="{x:Bind ViewModel.RefreshIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="30 saniyede bir" />
                    <ComboBoxItem Content="Dakikada bir" />
                    <ComboBoxItem Content="2 dakikada bir" />
                    <ComboBoxItem Content="5 dakikada bir" />
                    <ComboBoxItem Content="15 dakikada bir" />
                </ComboBox>
            </Grid>

            <Grid Style="{StaticResource CardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Uzak resimleri her zaman göster" />
                    <TextBlock
                        Text="Kapalıyken izleme piksellerine karşı dış kaynaklı resimler engellenir."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch
                    Grid.Column="1"
                    MinWidth="0"
                    IsOn="{x:Bind ViewModel.AlwaysShowRemoteImages, Mode=TwoWay}"
                    OffContent="Kapalı"
                    OnContent="Açık" />
            </Grid>

            <Grid Style="{StaticResource CardStyle}" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="İmza" />
                    <TextBlock
                        Text="Yeni iletilerin, yanıtların ve iletmelerin sonuna eklenir."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <controls:HtmlEditor x:Name="SignatureEditor" Grid.Row="1" Height="200" />
                <Button
                    Grid.Row="2"
                    Content="İmzayı kaydet"
                    Click="OnSaveSignature" />
            </Grid>

            <Grid Style="{StaticResource CardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Yeni posta bildirimleri" />
                    <TextBlock
                        Text="Gelen kutusuna yeni ileti düştüğünde Windows bildirimi gösterilir. Okunmamış sayısı görev çubuğu simgesinde görünür."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch
                    Grid.Column="1"
                    MinWidth="0"
                    IsOn="{x:Bind ViewModel.ShowNotifications, Mode=TwoWay}"
                    OffContent="Kapalı"
                    OnContent="Açık" />
            </Grid>

            <!--  Automatic replies  -->
            <TextBlock Text="Otomatik yanıtlar (ofis dışında)" Style="{StaticResource SectionStyle}" />
            <Grid Style="{StaticResource CardStyle}" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ToggleSwitch
                    Header="Otomatik yanıt gönder"
                    IsOn="{x:Bind ViewModel.AutoReply.IsEnabled, Mode=TwoWay}"
                    OffContent="Kapalı"
                    OnContent="Açık" />
                <StackPanel Grid.Row="1" Spacing="8" Visibility="{x:Bind ViewModel.AutoReply.IsEnabled, Mode=OneWay}">
                    <CheckBox Content="Yalnızca bu zaman aralığında gönder" IsChecked="{x:Bind ViewModel.AutoReply.IsScheduled, Mode=TwoWay}" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.AutoReply.CanEditSchedule, Mode=OneWay}">
                        <CalendarDatePicker Header="Başlangıç" Date="{x:Bind ViewModel.AutoReply.StartDate, Mode=TwoWay}" />
                        <TimePicker
                            Header="Saat"
                            ClockIdentifier="24HourClock"
                            MinuteIncrement="30"
                            Time="{x:Bind ViewModel.AutoReply.StartTime, Mode=TwoWay}" />
                        <CalendarDatePicker Margin="16,0,0,0" Header="Bitiş" Date="{x:Bind ViewModel.AutoReply.EndDate, Mode=TwoWay}" />
                        <TimePicker
                            Header="Saat"
                            ClockIdentifier="24HourClock"
                            MinuteIncrement="30"
                            Time="{x:Bind ViewModel.AutoReply.EndTime, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
                <TextBox
                    Grid.Row="2"
                    MinHeight="90"
                    AcceptsReturn="True"
                    Header="Kuruluşumdaki kişilere gönderilecek yanıt"
                    PlaceholderText="Ör. 1-5 Kasım arasında izindeyim. Acil konular için Ali Veli'ye (ali.veli@sirket.com.tr) yazabilirsiniz."
                    Text="{x:Bind ViewModel.AutoReply.InternalMessage, Mode=TwoWay}"
                    TextWrapping="Wrap" />
                <CheckBox Grid.Row="3" Content="Kuruluşum dışındaki kişilere de yanıt gönder" IsChecked="{x:Bind ViewModel.AutoReply.ReplyToExternal, Mode=TwoWay}" />
                <StackPanel Grid.Row="4" Spacing="8" Visibility="{x:Bind ViewModel.AutoReply.CanEditExternal, Mode=OneWay}">
                    <RadioButtons MaxColumns="2" SelectedIndex="{x:Bind ViewModel.AutoReply.ExternalAudienceIndex, Mode=TwoWay}">
                        <x:String>Yalnızca kişilerime</x:String>
                        <x:String>Herkese</x:String>
                    </RadioButtons>
                    <TextBox
                        MinHeight="90"
                        AcceptsReturn="True"
                        Header="Kuruluş dışına gönderilecek yanıt"
                        Text="{x:Bind ViewModel.AutoReply.ExternalMessage, Mode=TwoWay}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="12">
                    <Button Content="Otomatik yanıtları kaydet" Command="{x:Bind ViewModel.AutoReply.SaveCommand}" Style="{StaticResource AccentButtonStyle}" />
                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.AutoReply.IsBusy, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Row="6" Spacing="4">
                    <InfoBar
                        Severity="Error"
                        IsClosable="False"
                        IsOpen="{x:Bind h:Ui.HasText(ViewModel.AutoReply.ErrorMessage), Mode=OneWay}"
                        Message="{x:Bind ViewModel.AutoReply.ErrorMessage, Mode=OneWay}" />
                    <InfoBar
                        Severity="Success"
                        IsClosable="False"
                        IsOpen="{x:Bind h:Ui.HasText(ViewModel.AutoReply.InfoMessage), Mode=OneWay}"
                        Message="{x:Bind ViewModel.AutoReply.InfoMessage, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <!--  Application  -->
            <TextBlock Text="Uygulama" Style="{StaticResource SectionStyle}" />
            <Grid Style="{StaticResource CardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Kapatınca sistem tepsisine küçült" />
                    <TextBlock
                        Text="Pencereyi kapattığınızda Postacı arka planda yeni postaları denetlemeye ve bildirim göstermeye devam eder. Tamamen kapatmak için tepsi simgesine sağ tıklayıp Çıkış'ı seçin."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch
                    Grid.Column="1"
                    MinWidth="0"
                    IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}"
                    OffContent="Kapalı"
                    OnContent="Açık" />
            </Grid>
            <Grid Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.CanStartWithWindows}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Windows açılışında başlat" />
                    <TextBlock
                        Text="Windows'a giriş yaptığınızda Postacı sistem tepsisinde başlar ve kayıtlı hesapla bağlanır."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch
                    Grid.Column="1"
                    MinWidth="0"
                    IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"
                    OffContent="Kapalı"
                    OnContent="Açık" />
            </Grid>

            <!--  Appearance  -->
            <TextBlock Text="Görünüm" Style="{StaticResource SectionStyle}" />
            <Grid Style="{StaticResource CardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Tema" />
                <ComboBox Grid.Column="1" MinWidth="200" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="Windows ayarını kullan" />
                    <ComboBoxItem Content="Açık" />
                    <ComboBoxItem Content="Koyu" />
                </ComboBox>
            </Grid>

            <!--  Fonts  -->
            <TextBlock Text="Yazı tipleri" Style="{StaticResource SectionStyle}" />

            <Grid Style="{StaticResource CardStyle}" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Arayüz" />
                    <TextBlock
                        Text="Menüler, listeler ve düğmeler. Uygulama yeniden başlatılınca uygulanır."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ComboBox
                        Width="220"
                        Header="Yazı tipi"
                        ItemsSource="{x:Bind ViewModel.FontChoices}"
                        SelectedItem="{x:Bind ViewModel.UiFontChoice, Mode=TwoWay}" />
                    <ComboBox Width="150" Header="Boyut" SelectedIndex="{x:Bind ViewModel.UiTextScaleIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Küçük (%90)" />
                        <ComboBoxItem Content="Normal" />
                        <ComboBoxItem Content="Büyük (%115)" />
                        <ComboBoxItem Content="Çok büyük (%130)" />
                    </ComboBox>
                </StackPanel>
                <TextBlock
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Text="Örnek: Gelen Kutusu · Yanıtla · Toplantı 14:30"
                    FontFamily="{x:Bind h:Ui.Font(ViewModel.UiFontChoice), Mode=OneWay}"
                    FontSize="{x:Bind h:Ui.UiPreviewSize(ViewModel.UiTextScaleIndex), Mode=OneWay}" />
                <InfoBar
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsRestartNeeded, Mode=OneWay}"
                    Message="Arayüz yazı tipi değişikliği uygulama yeniden başlatılınca görünür."
                    Severity="Informational">
                    <InfoBar.ActionButton>
                        <Button Content="Şimdi yeniden başlat" Command="{x:Bind ViewModel.RestartCommand}" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </Grid>

            <Grid Style="{StaticResource CardStyle}" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="İleti okuma" />
                    <TextBlock
                        Text="Okuma bölmesi ve takvim ayrıntıları. Okurken Ctrl + fare tekerleği ile de yakınlaştırabilirsiniz."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ComboBox
                        Width="220"
                        Header="Varsayılan yazı tipi"
                        ItemsSource="{x:Bind ViewModel.FontChoices}"
                        SelectedItem="{x:Bind ViewModel.ReadingFontChoice, Mode=TwoWay}" />
                    <ComboBox Width="150" Header="Yakınlaştırma" SelectedIndex="{x:Bind ViewModel.ReadingZoomIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="%80" />
                        <ComboBoxItem Content="%90" />
                        <ComboBoxItem Content="%100" />
                        <ComboBoxItem Content="%110" />
                        <ComboBoxItem Content="%125" />
                        <ComboBoxItem Content="%150" />
                        <ComboBoxItem Content="%175" />
                        <ComboBoxItem Content="%200" />
                    </ComboBox>
                </StackPanel>
                <CheckBox
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Content="İletilerin kendi yazı tiplerini de bu yazı tipiyle değiştir"
                    IsChecked="{x:Bind ViewModel.ReadingFontOverride, Mode=TwoWay}" />
                <TextBlock
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Text="Merhaba, toplantı notlarını ekte bulabilirsiniz. İyi çalışmalar."
                    FontFamily="{x:Bind h:Ui.Font(ViewModel.ReadingFontChoice), Mode=OneWay}"
                    FontSize="{x:Bind h:Ui.ReadingPreviewSize(ViewModel.ReadingZoomIndex), Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Grid>

            <Grid Style="{StaticResource CardStyle}" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Yeni ileti yazma" />
                    <TextBlock
                        Text="Yazma penceresi ve imza düzenleyicisi. Alıcılar iletiyi bu yazı tipi ve boyutta görür."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ComboBox
                        Width="220"
                        Header="Yazı tipi"
                        ItemsSource="{x:Bind ViewModel.FontChoices}"
                        SelectedItem="{x:Bind ViewModel.ComposeFontChoice, Mode=TwoWay}" />
                    <ComboBox Width="150" Header="Boyut" SelectedIndex="{x:Bind ViewModel.ComposeFontSizeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="9 pt" />
                        <ComboBoxItem Content="10 pt" />
                        <ComboBoxItem Content="11 pt" />
                        <ComboBoxItem Content="12 pt" />
                        <ComboBoxItem Content="14 pt" />
                        <ComboBoxItem Content="16 pt" />
                        <ComboBoxItem Content="18 pt" />
                    </ComboBox>
                </StackPanel>
                <TextBlock
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Text="Merhaba Ayşe Hanım, yarınki toplantı için gündemi paylaşıyorum."
                    FontFamily="{x:Bind h:Ui.Font(ViewModel.ComposeFontChoice), Mode=OneWay}"
                    FontSize="{x:Bind h:Ui.ComposePreviewSize(ViewModel.ComposeFontSizeIndex), Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Grid>

            <!--  Account  -->
            <TextBlock Text="Hesap" Style="{StaticResource SectionStyle}" />
            <Grid Style="{StaticResource CardStyle}" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="E-posta" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AccountEmail}" IsTextSelectionEnabled="True" />
                <TextBlock Grid.Row="1" Text="Sunucu (EWS)" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.ServerUrl}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Text="Oturum açma" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SignInText}" />
                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                    <Button Content="Kayıtlı parolayı sil" Command="{x:Bind ViewModel.ForgetPasswordCommand}" />
                    <Button Command="{x:Bind ViewModel.SignOutCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xF3B1;" FontSize="14" />
                            <TextBlock Text="Oturumu kapat" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <TextBlock
                Margin="4,0"
                Text="Uygulamayı pencereden kapatmak oturumu kapatmaz; bir sonraki açılışta otomatik bağlanılır. &quot;Oturumu kapat&quot; kayıtlı parolayı da siler."
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />

            <!--  About  -->
            <TextBlock Text="Hakkında" Style="{StaticResource SectionStyle}" />
            <Grid Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Postacı" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.AppVersion}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Text="Veriler yalnızca yapılandırılan Exchange sunucusuna gönderilir; uygulama telemetri toplamaz."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
