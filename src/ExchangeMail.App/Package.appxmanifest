<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX package of Postacı, published through the Microsoft Store (the Store signs it).

  Identity Name, Publisher and PublisherDisplayName must be the values Partner Center shows under
  Product management > Product identity once the app name is reserved; the Store rejects any other.
  Version is set from the release tag by the release workflow (the fourth part stays 0, as the Store requires).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 com desktop rescap">

  <Identity Name="ordaolmayanadam.Postaci" Publisher="CN=11DAC254-BB98-4C42-A0B8-FA97F2A1F4F4" Version="1.0.0.0" />

  <Properties>
    <DisplayName>Postacı</DisplayName>
    <PublisherDisplayName>ordaolmayanadam</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!-- The languages of the interface. The first is the package's default and matches DefaultLanguage in the project. -->
  <Resources>
    <Resource Language="en-US" />
    <Resource Language="tr-TR" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Postacı"
        Description="Mail, calendar and contacts for on-premises Exchange"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- A click on a notification while Postacı is closed starts it through this COM activator. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="Postaci.exe" Arguments="----AppNotificationActivated:" DisplayName="Postacı">
              <com:Class Id="48ED4A3C-A416-4DEC-9C32-F5215A2B374E" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="48ED4A3C-A416-4DEC-9C32-F5215A2B374E" />
        </desktop:Extension>

        <!-- "Start with Windows" (Settings); TaskId must match StartupTaskService.TaskId. -->
        <uap5:Extension Category="windows.startupTask" Executable="Postaci.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="PostaciStartup" Enabled="false" DisplayName="Postacı" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
