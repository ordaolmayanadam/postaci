<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ExchangeMail.App</RootNamespace>
    <AssemblyName>Postaci</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Postaci.ico</ApplicationIcon>
    <Product>Postacı</Product>
    <AssemblyTitle>Postacı</AssemblyTitle>
    <Description>Şirket içi Exchange için posta, takvim ve kişiler</Description>
    <Version>1.0.0</Version>
    <Copyright>Copyright (c) 2026 Postacı contributors · MIT License</Copyright>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged: runs straight from bin/ or an xcopy folder, no MSIX/certificate needed. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Assets\**" />
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExchangeMail.ViewModels\ExchangeMail.ViewModels.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="ExchangeMail.Core.Localization" />
  </ItemGroup>
</Project>
